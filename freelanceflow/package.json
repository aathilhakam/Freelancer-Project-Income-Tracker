{
  "name": "freelanceflow",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "seed": "npm run seed -w server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10"
  }
}
